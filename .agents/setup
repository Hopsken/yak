#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Preparing mise'
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
fi
mise trust mise.toml

echo "Installing pinned toolchains (${SECONDS}s elapsed)"
mise install
eval "$(mise env -s bash)"
node --version
pnpm --version

# Activate the complete project environment in future non-interactive login shells.
profile_marker="# Yak orb mise environment: $PWD"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${YAK_MISE_ACTIVE:-}" && ( "\$PWD" == "$PWD" || "\$PWD" == "$PWD/"* ) ]]; then
  export YAK_MISE_ACTIVE=1
  export PATH="$(dirname "$(command -v mise)"):\$PATH"
  eval "\$(mise env -s bash)"
fi
EOF
fi

echo "Installing locked dependencies (${SECONDS}s elapsed)"
CI=true pnpm install --frozen-lockfile

# Runtime PDS configuration is generated by pnpm dev:network.
# See docs/development-network.md; never copy test credentials into snapshots.

echo "Orb setup finished in ${SECONDS}s"
